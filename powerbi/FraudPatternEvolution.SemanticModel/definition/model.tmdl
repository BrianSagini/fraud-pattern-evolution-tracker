model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RiskSummary", "Trends", "NetworkSummary"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table RiskSummary
ref table Trends
ref table NetworkSummary

ref cultureInfo en-US
