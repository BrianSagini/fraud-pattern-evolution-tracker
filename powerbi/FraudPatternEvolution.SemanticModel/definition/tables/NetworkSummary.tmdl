	measure 'Ring Candidate Accounts' = CALCULATE(DISTINCTCOUNT(NetworkSummary[account_id]), NetworkSummary[is_ring_candidate] = TRUE)
		formatString: #,0
		lineageTag: 351beb89-97a7-45a5-87ff-b687593ffe63

	measure 'Avg Cluster Size' = AVERAGE(NetworkSummary[component_size])
		formatString: 0.0
		lineageTag: f63d04bb-1671-42a5-b6f2-0c8f3824f2ac

	partition NetworkSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					fraud_pattern_powerbi_network_summary = Source{[Schema="fraud_pattern",Item="powerbi_network_summary"]}[Data]
				in
					fraud_pattern_powerbi_network_summary

	annotation PBI_ResultType = Table
