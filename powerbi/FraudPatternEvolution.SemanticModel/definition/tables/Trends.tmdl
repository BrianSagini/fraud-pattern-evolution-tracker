table Trends
	lineageTag: 867ad5da-eb5c-4eed-8d5b-870172e9ab6e

	column month
		dataType: dateTime
		lineageTag: a555d849-c125-4081-bb2c-cc2e20f5307f
		summarizeBy: none
		formatString: yyyy-MM
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column total_transactions
		dataType: int64
		lineageTag: becac7e8-ef15-4033-8a30-7f0e08f4dfad
		summarizeBy: none
		formatString: #,0
		sourceColumn: total_transactions

		annotation SummarizationSetBy = Automatic

	column fraud_transactions
		dataType: int64
		lineageTag: 5e1c92c4-7cff-4ac4-8a70-ca5cdfc3c08b
		summarizeBy: none
		formatString: #,0
		sourceColumn: fraud_transactions

		annotation SummarizationSetBy = Automatic

	column fraud_rate
		dataType: double
		lineageTag: 888327d3-00ab-4c2a-ad10-f239c8687de3
		summarizeBy: none
		formatString: 0.00%
		sourceColumn: fraud_rate

		annotation SummarizationSetBy = Automatic

	column total_amount
		dataType: decimal
		lineageTag: ce57398e-85e8-4dad-bddd-a79eeb433b81
		summarizeBy: none
		formatString: "$"#,0
		sourceColumn: total_amount

		annotation SummarizationSetBy = Automatic

	column fraud_amount
		dataType: decimal
		lineageTag: a34c3a9c-6df1-4f52-be18-6404fbb4909b
		summarizeBy: none
		formatString: "$"#,0
		sourceColumn: fraud_amount

		annotation SummarizationSetBy = Automatic

	partition Trends = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5443", "analytics"),
					fraud_pattern_powerbi_trends = Source{[Schema="fraud_pattern",Item="powerbi_trends"]}[Data]
				in
					fraud_pattern_powerbi_trends

	annotation PBI_ResultType = Table
