# Copy to .env before first run. No API key is required for this project's
# data source (see docs/data_sources.md).

POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics_dev_password
POSTGRES_HOST_PORT=5433

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_password

ANALYTICS_DB_NAME=analytics
ANALYTICS_RO_USER=analytics_ro
ANALYTICS_RO_PASSWORD=analytics_ro_dev_password

AIRFLOW_UID=50000
AIRFLOW_HOST_PORT=8081
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_dev_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Required -- Airflow 3's apiserver refuses to start with these unset.
# Generate real values before first `docker compose up`:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

DASHBOARD_PORT=8501
